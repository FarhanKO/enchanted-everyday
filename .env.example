# Every setting the app reads. Copy to .env on the server (chmod 600, owned by the app user).
# Never commit .env. Rotate any value that leaks.

# --- Runtime ---
ENV=dev                                # dev | prod
DRY_RUN=true                           # true = render and preview, never publish
TIMEZONE=Asia/Dhaka
DAILY_RUN_CRON=0 5 * * *               # evaluated in TIMEZONE
APPROVAL_CUTOFF_HOUR=12
LOG_LEVEL=INFO

# --- Database (Compose sets the host to "postgres") ---
POSTGRES_USER=engine
POSTGRES_PASSWORD=change-me
POSTGRES_DB=engine
DATABASE_URL=postgresql+psycopg://engine:change-me@postgres:5432/engine

# --- Prefect ---
PREFECT_API_URL=http://prefect-server:4200/api

# --- Content (open decisions: see docs/decisions.md) ---
NICHE=                                 # blocks Phase 1; e.g. "personal finance for students"
CONTENT_LANGUAGE=en                    # en | bn
TRENDS_GEO=US                          # Google Trends country code
NICHE_RSS_FEEDS=                       # comma-separated feed URLs
YOUTUBE_SEARCH_QUERY=                  # defaults to NICHE when empty

# --- LLM ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium                      # low | medium | high
DAILY_SPEND_CAP_USD=2.00               # hard stop for LLM + paid assets per run date

# --- Object storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=content-engine
R2_PUBLIC_BASE_URL=                    # e.g. https://media.example.com (public bucket or custom domain)

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=                     # your numeric user ID; the bot ignores everyone else

# --- Stock media ---
PEXELS_API_KEY=

# --- Platforms (Phase 3) ---
YOUTUBE_API_KEY=                       # trend search only (Data API v3 key)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_UPLOAD_ENABLED=false           # flip after the API audit clears
META_PAGE_ID=
META_IG_USER_ID=
META_PAGE_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# --- Monitoring ---
HEALTHCHECK_PING_URL=                  # dead-man's switch (e.g. healthchecks.io), expects a ping by 09:00
