# Every setting the app reads. Copy to .env on the server (chmod 600, owned by the app user).
# Never commit .env. Rotate any value that leaks.

# --- Runtime ---
# dev | prod
ENV=dev
# true = render and preview, never publish
DRY_RUN=true
TIMEZONE=Asia/Dhaka
# 05:00 Sun, Tue, Thu, Sat in TIMEZONE (4 a week)
DAILY_RUN_CRON=0 5 * * 0,2,4,6
# 10:00 daily: Meta and YouTube login check, fix-it steps to Telegram
LOGIN_CHECK_CRON=0 10 * * *
# start Meta renewal reminders this many days before access runs out
LOGIN_WARN_DAYS=3
APPROVAL_CUTOFF_HOUR=12
LOG_LEVEL=INFO

# --- Database (Compose sets the host to "postgres") ---
POSTGRES_USER=engine
POSTGRES_PASSWORD=change-me
POSTGRES_DB=engine
DATABASE_URL=postgresql+psycopg://engine:change-me@postgres:5432/engine

# --- Prefect ---
PREFECT_API_URL=http://prefect-server:4200/api

# --- Content: Modern Fairy Tales for Sleepless Souls (see brand/) ---
# story bible, production style, slate
BRAND_DIR=brand
CONTENT_LANGUAGE=en

# --- LLM ---
# One of the two. OpenRouter wins when both are set; it routes to Anthropic, so allow the
# Anthropic provider in openrouter.ai/settings/privacy or every call fails with "no allowed providers".
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# default for every agent: low | medium | high | xhigh | max
LLM_EFFORT=medium
# Per-agent overrides as JSON. Agents: story_architect, script_writer, visual_director, packager, critic.
# The code defaults to {"script_writer": "high", "critic": "high"} for efforts, and Opus everywhere
# except the storyboard and package: {"visual_director": "claude-sonnet-5-5", "packager": "claude-sonnet-5-5"}.
# Setting LLM_MODELS replaces that whole default.
# LLM_MODELS={"visual_director": "claude-sonnet-5-5", "packager": "claude-sonnet-5-5"}
# LLM_EFFORTS={"script_writer": "high", "critic": "high"}
# hard stop for LLM + paid assets per run date
DAILY_SPEND_CAP_USD=2.50

# --- Embeddings (local; ~90 MB model downloads on first use) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# empty = temp dir; Compose points the worker at its volume
EMBEDDING_CACHE_DIR=

# --- Media (Phase 2: voice, frames, render; engine/media/) ---
# via OPENROUTER_API_KEY, ~$0.04 a frame
IMAGE_MODEL=google/gemini-nano-banana-2.1
# Nano Banana 2, if the first refuses or fails
IMAGE_FALLBACK_MODEL=google/gemini-3.1-flash-image
# media, renders and the paid-for cache; Compose uses its volume
WORK_DIR=work
# licensed tracks + library.toml; empty = no music bed
MUSIC_DIR=templates/music
RENDER_FPS=30
# x264 quality of the master (capped at 4.5 Mb/s)
RENDER_CRF=20
# Voice: ElevenLabs built-in voices through OPENROUTER_API_KEY; the cast is in brand/voices.toml.
# Allow the ElevenLabs provider in openrouter.ai/settings/privacy. A direct key is only for a clone later.
ELEVENLABS_API_KEY=
# AI video (not used yet: ai_clip shots render as still drift). For at most 2 clips an episode.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
# pro mode
VIDEO_MODEL=kling-v3

# --- Object storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=content-engine
# e.g. https://media.example.com (public bucket or custom domain)
R2_PUBLIC_BASE_URL=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# your numeric user ID; the bot ignores everyone else
TELEGRAM_OWNER_ID=

# --- Platforms (Phase 3) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# flip after the API audit clears
YOUTUBE_UPLOAD_ENABLED=false
META_PAGE_ID=
META_IG_USER_ID=
META_PAGE_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# --- Monitoring ---
# dead-man's switch (e.g. healthchecks.io), expects a ping by 09:00
HEALTHCHECK_PING_URL=
