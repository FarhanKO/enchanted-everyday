# Every setting the app reads. Copy to .env on the server (chmod 600, owned by the app user).
# Never commit .env. Rotate any value that leaks.

# --- Runtime ---
ENV=dev                                # dev | prod
DRY_RUN=true                           # true = render and preview, never publish
TIMEZONE=Asia/Dhaka
DAILY_RUN_CRON=0 5 * * 0,2,4,6         # 05:00 Sun, Tue, Thu, Sat in TIMEZONE (4 a week)
APPROVAL_CUTOFF_HOUR=12
LOG_LEVEL=INFO

# --- Database (Compose sets the host to "postgres") ---
POSTGRES_USER=engine
POSTGRES_PASSWORD=change-me
POSTGRES_DB=engine
DATABASE_URL=postgresql+psycopg://engine:change-me@postgres:5432/engine

# --- Prefect ---
PREFECT_API_URL=http://prefect-server:4200/api

# --- Content: Modern Fairy Tales for Sleepless Souls (see brand/) ---
BRAND_DIR=brand                        # story bible, production style, slate
CONTENT_LANGUAGE=en

# --- LLM ---
# One of the two. OpenRouter wins when both are set; it routes to Anthropic, so allow the
# Anthropic provider in openrouter.ai/settings/privacy or every call fails with "no allowed providers".
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium                      # default for every agent: low | medium | high | xhigh | max
# Per-agent overrides as JSON. Agents: story_architect, script_writer, visual_director, packager, critic.
# The code defaults to {"script_writer": "high", "critic": "high"} for efforts and Opus everywhere.
# LLM_MODELS={"packager": "claude-sonnet-5-5"}
# LLM_EFFORTS={"script_writer": "high", "critic": "high"}
DAILY_SPEND_CAP_USD=2.00               # hard stop for LLM + paid assets per run date

# --- Embeddings (local; ~90 MB model downloads on first use) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_CACHE_DIR=                   # empty = temp dir; Compose points the worker at its volume

# --- Media (Phase 2; read once those stages are built, see docs/decisions.md) ---
IMAGE_MODEL=google/gemini-nano-banana-2.1   # via OPENROUTER_API_KEY; fallback google/gemini-3.1-flash-image
KLING_ACCESS_KEY=                      # Kling Open Platform, for at most 2 AI clips per episode
KLING_SECRET_KEY=
VIDEO_MODEL=kling-v3                   # pro mode
# Voice: ElevenLabs built-in voices through OPENROUTER_API_KEY; the cast is in brand/voices.toml.
# Allow the ElevenLabs provider in openrouter.ai/settings/privacy. A direct key is only for a clone later.
ELEVENLABS_API_KEY=

# --- Object storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=content-engine
R2_PUBLIC_BASE_URL=                    # e.g. https://media.example.com (public bucket or custom domain)

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=                     # your numeric user ID; the bot ignores everyone else

# --- Platforms (Phase 3) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_UPLOAD_ENABLED=false           # flip after the API audit clears
META_PAGE_ID=
META_IG_USER_ID=
META_PAGE_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# --- Monitoring ---
HEALTHCHECK_PING_URL=                  # dead-man's switch (e.g. healthchecks.io), expects a ping by 09:00
