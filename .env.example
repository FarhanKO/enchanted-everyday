
# --- Embeddings (local; ~90 MB model downloads on first use) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_CACHE_DIR=                   # empty = temp dir; Compose points the worker at its volume
# empty = temp dir; Compose points the worker at its volume
EMBEDDING_CACHE_DIR=

# --- Media (Phase 2: voice, frames, render; engine/media/) ---
IMAGE_MODEL=google/gemini-nano-banana-2.1   # via OPENROUTER_API_KEY, ~$0.04 a frame
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=content-engine
R2_PUBLIC_BASE_URL=                    # e.g. https://media.example.com (public bucket or custom domain)
# e.g. https://media.example.com (public bucket or custom domain)
R2_PUBLIC_BASE_URL=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=                     # your numeric user ID; the bot ignores everyone else
# your numeric user ID; the bot ignores everyone else
TELEGRAM_OWNER_ID=

# --- Platforms (Phase 3) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_UPLOAD_ENABLED=false           # flip after the API audit clears
META_PAGE_ID=
META_IG_USER_ID=
META_PAGE_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# --- Monitoring ---
HEALTHCHECK_PING_URL=                  # dead-man's switch (e.g. healthchecks.io), expects a ping by 09:00
# dead-man's switch (e.g. healthchecks.io), expects a ping by 09:00
HEALTHCHECK_PING_URL=
